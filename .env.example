# Export these variables before starting the backend. No automatic .env loading.
LIBEROMNIA_ADDRESS=127.0.0.1
LIBEROMNIA_PORT=8080
# Drogon runtime files live here; a future SQLite database will also use this path.
LIBEROMNIA_DATA_DIR=./data
# Exact browser origin, no trailing slash. Empty disables cross-origin access.
LIBEROMNIA_FRONTEND_ORIGIN=http://localhost:5173
# Global search limits; no external provider is registered in this version.
LIBEROMNIA_SEARCH_CONCURRENCY=4
LIBEROMNIA_SEARCH_MAX_PENDING=64
LIBEROMNIA_SEARCH_MAX_SESSIONS=32
LIBEROMNIA_SEARCH_MAX_RECORDS=200
LIBEROMNIA_SEARCH_TIMEOUT_MS=8000
LIBEROMNIA_SEARCH_SESSION_TTL_MS=900000
